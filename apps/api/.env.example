# API environment variables.
# Copy this file to `.env` and adjust if needed:  cp apps/api/.env.example apps/api/.env
NODE_ENV=development
PORT=4000

# Connection string for the PostgreSQL container started by docker-compose.
# Keep the user/password/database/port in sync with the root `.env` file.
DATABASE_URL=postgresql://opsflow:opsflow@localhost:5432/opsflow?schema=public

# Comma-separated list of allowed browser origins (web dev server by default).
CORS_ORIGIN=http://localhost:5173
